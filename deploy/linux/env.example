# Copia in deploy/linux/.env e adatta i valori al tuo server Linux.
PDF_BACKEND=libreoffice
LIBREOFFICE_BIN=soffice
FLASK_PORT=5000
FLASK_DEBUG=0
WEBDAV_PORT=8080
WEBDAV_HOST=0.0.0.0
WEBDAV_BASE_URL=http://your-server:8080
OUTPUT_DIR=output
UPLOAD_FOLDER=uploads
TEMPLATE_ATTO=template/ASL_Template_Atto.docx
